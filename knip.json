{
  "$schema": "https://unpkg.com/knip@latest/schema.json",
  "entry": [
    "src/server/index.ts",
    "src/client/main.tsx",
    "src/client/ui/overlay/declarative.ts",
    "src/**/*.test.{ts,tsx}",
    "scripts/*.ts",
    "src/server/testbed/cores/*/smoke/*.smoke.ts",
    "src/server/testbed/testing/*/smoke/*.smoke.ts",
    "examples/**/*.ts",
    "src/server/testbed/external/fake-core.ts",
    "e2e/*.e2e.ts",
    "e2e/**/*.test.ts"
  ],
  "project": ["src/**/*.{ts,tsx}", "scripts/**/*.ts", "e2e/**/*.ts", "examples/**/*.ts"],
  "ignoreBinaries": ["index.js"]
}
